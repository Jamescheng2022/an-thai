{
  "redirects": [
    {
      "source": "/insights.html",
      "destination": "/insights/",
      "permanent": true
    },
    {
      "source": "/equipment.html",
      "destination": "/powder-equipment.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
